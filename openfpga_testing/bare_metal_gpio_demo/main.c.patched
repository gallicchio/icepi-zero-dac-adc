#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <irq.h>
#include <libbase/uart.h>
#include <libbase/console.h>
#include <generated/csr.h>

/*-----------------------------------------------------------------------*/
/* Uart                                                                  */
/*-----------------------------------------------------------------------*/

static char *readstr(void)
{
	char c[2];
	static char s[64];
	static int ptr = 0;

	if(readchar_nonblock()) {
		c[0] = getchar();
		c[1] = 0;
		switch(c[0]) {
			case 0x7f:
			case 0x08:
				if(ptr > 0) {
					ptr--;
					fputs("\x08 \x08", stdout);
				}
				break;
			case 0x07:
				break;
			case '\r':
			case '\n':
				s[ptr] = 0x00;
				fputs("\n", stdout);
				ptr = 0;
				return s;
			default:
				if(ptr >= (sizeof(s) - 1))
					break;
				fputs(c, stdout);
				s[ptr] = c[0];
				ptr++;
				break;
		}
	}

	return NULL;
}

static char *get_token(char **str)
{
	char *c, *d;

	c = (char *)strchr(*str, ' ');
	if(c == NULL) {
		d = *str;
		*str = *str+strlen(*str);
		return d;
	}
	*c = 0;
	d = *str;
	*str = c+1;
	return d;
}

static void prompt(void)
{
	printf("\e[92;1mlitex-demo-app\e[0m> ");
}

/*-----------------------------------------------------------------------*/
/* Help                                                                  */
/*-----------------------------------------------------------------------*/

static void help(void)
{
	puts("\nLiteX minimal demo app built "__DATE__" "__TIME__"\n");
	puts("Available commands:");
	puts("help               - Show this command");
	puts("reboot             - Reboot CPU");
#ifdef CSR_LEDS_BASE
	puts("led                - Led demo");
#endif
#ifdef CSR_LEDS8_BASE
	puts("gpio               - Read switches/buttons, drive the 8-LED PMOD");
	puts("ledtest            - Hold distinct LED patterns to check polarity/bit order");
#endif
	puts("donut              - Spinning Donut demo");
	puts("helloc             - Hello C");
#ifdef WITH_CXX
	puts("hellocpp           - Hello C++");
#endif
}

/*-----------------------------------------------------------------------*/
/* Commands                                                              */
/*-----------------------------------------------------------------------*/

static void reboot_cmd(void)
{
	ctrl_reset_write(1);
}

#ifdef CSR_LEDS_BASE
static void led_cmd(void)
{
	int i;
	printf("Led demo...\n");

	printf("Counter mode...\n");
	for(i=0; i<32; i++) {
		leds_out_write(i);
		busy_wait(100);
	}

	printf("Shift mode...\n");
	for(i=0; i<4; i++) {
		leds_out_write(1<<i);
		busy_wait(200);
	}
	for(i=0; i<4; i++) {
		leds_out_write(1<<(3-i));
		busy_wait(200);
	}

	printf("Dance mode...\n");
	for(i=0; i<4; i++) {
		leds_out_write(0x55);
		busy_wait(200);
		leds_out_write(0xaa);
		busy_wait(200);
	}
}
#endif

#ifdef CSR_LEDS8_BASE
static void gpio_demo_cmd(void)
{
	/* Bounded (not infinite, unlike the openfpga.md tutorial version) so
	 * this can be driven from a scripted serial capture with no PMODs
	 * physically attached -- prints each reading since there's no LED to
	 * watch. Change to while(1) for interactive use once PMODs are wired
	 * up and you want to watch the LEDs track the switches/buttons live. */
	int i;
	printf("Reading switches/buttons, driving the 8-LED PMOD, 20 iterations.\n");
	for (i = 0; i < 20; i++) {
		uint32_t switches = switches_in_read();  // bits [3:0], 1 = up
		uint32_t buttons  = buttons_in_read();   // bits [3:0], 1 = held
		// Switches sit physically above the buttons on the panel, so give
		// them the high nibble to match, buttons the low nibble -- both CSRs
		// already read with the natural "1 = on/pressed" sense, since the
		// active-low/idle-high inversion was fixed in the gateware.
		uint32_t pattern = (switches << 4) | buttons;
		leds8_out_write(pattern);   // 1 = on, same reason
		printf("switches=0x%01lx buttons=0x%01lx -> leds8_out=0x%02lx (readback=0x%02lx)\n",
			(unsigned long)switches, (unsigned long)buttons,
			(unsigned long)pattern, (unsigned long)leds8_out_read());
		busy_wait(200);
	}
}

/* Diagnostic: hold each of several distinct, unambiguous LED states for a
 * few seconds so polarity and bit-order can be confirmed by eye against a
 * static reading, rather than guessing from one pattern under uncertain
 * lighting. Loops forever (this command is meant to be started, then
 * watched at the user's own pace with no serial connection required --
 * the CPU keeps running/holding states independently of whether anything
 * is listening on the UART). Reset/reflash the board to stop it. */
static void ledtest_cmd(void)
{
	printf("Looping LED polarity/bit-order test forever. Reset the board to stop.\n");
	while (1) {
		printf("all off (0x00) for 4s...\n");
		leds8_out_write(0x00);
		busy_wait(4000);

		printf("all on (0xff) for 4s...\n");
		leds8_out_write(0xff);
		busy_wait(4000);

		printf("low nibble only (0x0f) for 4s...\n");
		leds8_out_write(0x0f);
		busy_wait(4000);

		printf("high nibble only (0xf0) for 4s...\n");
		leds8_out_write(0xf0);
		busy_wait(4000);

		printf("single LED, bit 0 only (0x01) for 4s...\n");
		leds8_out_write(0x01);
		busy_wait(4000);

		printf("single LED, bit 7 only (0x80) for 4s...\n");
		leds8_out_write(0x80);
		busy_wait(4000);
	}
}
#endif

extern void donut(void);

static void donut_cmd(void)
{
	printf("Donut demo...\n");
	donut();
}

extern void helloc(void);

static void helloc_cmd(void)
{
	printf("Hello C demo...\n");
	helloc();
}

#ifdef WITH_CXX
extern void hellocpp(void);

static void hellocpp_cmd(void)
{
	printf("Hello C++ demo...\n");
	hellocpp();
}
#endif

/*-----------------------------------------------------------------------*/
/* Console service / Main                                                */
/*-----------------------------------------------------------------------*/

static void console_service(void)
{
	char *str;
	char *token;

	str = readstr();
	if(str == NULL) return;
	token = get_token(&str);
	if(strcmp(token, "help") == 0)
		help();
	else if(strcmp(token, "reboot") == 0)
		reboot_cmd();
#ifdef CSR_LEDS_BASE
	else if(strcmp(token, "led") == 0)
		led_cmd();
#endif
#ifdef CSR_LEDS8_BASE
	else if(strcmp(token, "gpio") == 0)
		gpio_demo_cmd();
	else if(strcmp(token, "ledtest") == 0)
		ledtest_cmd();
#endif
	else if(strcmp(token, "donut") == 0)
		donut_cmd();
	else if(strcmp(token, "helloc") == 0)
		helloc_cmd();
#ifdef WITH_CXX
	else if(strcmp(token, "hellocpp") == 0)
		hellocpp_cmd();
#endif
	prompt();
}

int main(void)
{
#ifdef CONFIG_CPU_HAS_INTERRUPT
	irq_setmask(0);
	irq_setie(1);
#endif
	uart_init();

	help();
	prompt();

	while(1) {
		console_service();
	}

	return 0;
}
